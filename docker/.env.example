# Secure Docker Environment Template
# Copy to docker/.env and update with secure values

COMPOSE_PROJECT_NAME=superset

# Database configurations
DATABASE_DB=superset
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_DIALECT=postgresql

# Generate secure passwords for production!
# Use: openssl rand -base64 32
DATABASE_PASSWORD=changeme
DATABASE_USER=superset

POSTGRES_DB=superset
POSTGRES_USER=superset
POSTGRES_PASSWORD=changeme

# Examples database (if needed)
EXAMPLES_DB=examples
EXAMPLES_HOST=db
EXAMPLES_USER=examples
EXAMPLES_PASSWORD=changeme
EXAMPLES_PORT=5432

# Redis configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Flask configuration
FLASK_DEBUG=false
SUPERSET_ENV=production
SUPERSET_LOAD_EXAMPLES=no
SUPERSET_PORT=8088

# Generate a unique secret key!
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
SUPERSET_SECRET_KEY=CHANGE_THIS_TO_A_REAL_SECRET_KEY

# Security settings
ENABLE_CORS=false
WTF_CSRF_ENABLED=true

# Optional services
ENABLE_PLAYWRIGHT=false
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
BUILD_SUPERSET_FRONTEND_IN_DOCKER=false

# Analytics
SCARF_ANALYTICS=false
