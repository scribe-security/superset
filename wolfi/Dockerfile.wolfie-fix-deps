# Build Stage
ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS build
# Final Base Image
FROM cgr.dev/chainguard/wolfi-base:latest

# Environment Variables (removing the SECRET_KEY)
ENV LANG=C.UTF-8 \
  LC_ALL=C.UTF-8 \
  SUPERSET_ENV=production \
  FLASK_APP="superset.app:create_app()" \
  PYTHONPATH="/app/pythonpath" \
  SUPERSET_HOME="/app/superset_home" \
  SUPERSET_PORT=8088

# Set working directory
WORKDIR /app

# Update & Install Dependencies
# Note: Ensure Wolfi/Chainguard repo has updated Python packages to address CVE-2025-0938
RUN apk update --no-cache && \
  # List available Python packages to find the latest version
  apk search python-3 && \
  # List available PostgreSQL packages to find the correct version  
  apk search postgresql && \
  # Install the latest available Python 3.11 or 3.12 version
  apk add --no-cache \
  python-3.11 || apk add --no-cache python-3.12 && \
  apk add --no-cache \
  py3.11-pip || apk add --no-cache py3.12-pip && \
  apk add --no-cache \
  python-3.11-dev || apk add --no-cache python-3.12-dev && \
  apk add --no-cache \
  build-base \
  bash \
  make \
  tzdata \
  curl \
  wget \
  postgresql-client

# Try to install PostgreSQL dev packages if they exist
RUN apk add --no-cache postgresql-dev || echo "Using default PostgreSQL development libraries"

# Create Superset user and directories
RUN mkdir -p ${SUPERSET_HOME} && \
  adduser -D -h ${SUPERSET_HOME} superset && \
  chown -R superset:superset ${SUPERSET_HOME}

# Copy build artifacts
COPY --from=build --chown=superset:superset /app /app

# Updated run-server.sh path
COPY --from=build --chown=superset:superset /usr/bin/run-server.sh /usr/bin/run-server.sh
RUN chmod +x /usr/bin/run-server.sh

# Copy pythonpath and assets
RUN mkdir -p /app/pythonpath
COPY --chown=superset:superset ./docker/pythonpath/* /app/pythonpath/
COPY --from=build --chown=superset:superset /app/superset/static/assets /app/superset/static/assets

# Copy the updated requirements file
COPY --chown=superset:superset requirements/base.txt /app/requirements/base.txt

# Install virtualenv and Python requirements in a virtual environment
RUN pip3.11 install virtualenv && \
  virtualenv /app/venv
ENV PATH="/app/venv/bin:$PATH"

# Install base Python packages without version conflicts
RUN pip3.11 install --upgrade pip setuptools wheel flask-cors && \
  # Install requirements from base.txt first
  pip3.11 install -r /app/requirements/base.txt && \
  # Only upgrade packages that don't conflict with base.txt
  pip3.11 install --upgrade \
    jinja2>=3.1.4 \
    urllib3>=1.26.18 \
    cryptography>=42.0.7 \
    werkzeug>=3.0.6 && \
  # Install psycopg2-binary which works without PostgreSQL dev packages
  pip3.11 install psycopg2-binary && \
  # Install boto3 for AWS S3 operations
  pip3.11 install boto3==1.34.24 && \
  # Verify that the correct versions are installed
  python -c "import importlib.metadata; print('--- Package versions ---'); print(f'jinja2={importlib.metadata.version(\"jinja2\")}'); print(f'gunicorn={importlib.metadata.version(\"gunicorn\")}'); print(f'flask-appbuilder={importlib.metadata.version(\"flask-appbuilder\")}'); print(f'urllib3={importlib.metadata.version(\"urllib3\")}'); print(f'cryptography={importlib.metadata.version(\"cryptography\")}'); print(f'certifi={importlib.metadata.version(\"certifi\")}'); print(f'zipp={importlib.metadata.version(\"zipp\")}')" && \
  # Run a quick test to verify psycopg2 installation
  python -c "import psycopg2; print(f'Successfully installed psycopg2 {psycopg2.__version__}')"

# Install Geckodriver only (dockerize not needed)
ENV GECKODRIVER_VERSION=0.36.0
RUN wget -q "https://github.com/mozilla/geckodriver/releases/download/v${GECKODRIVER_VERSION}/geckodriver-v${GECKODRIVER_VERSION}-linux64.tar.gz" && \
  tar -xzf geckodriver-v${GECKODRIVER_VERSION}-linux64.tar.gz -C /usr/bin geckodriver && \
  chmod +x /usr/bin/geckodriver && \
  rm -rf geckodriver-v${GECKODRIVER_VERSION}-linux64.tar.gz

# Note: Dockerize was not being used in the original scripts, so it's safe to remove

# Switch to non-root Superset user
USER superset

# Healthcheck
HEALTHCHECK CMD curl -f "http://localhost:${SUPERSET_PORT}/health" || exit 1

# Expose the application port
EXPOSE ${SUPERSET_PORT}

# Start Superset server (expecting SECRET_KEY to be provided at runtime)
CMD ["/usr/bin/run-server.sh"]
