# Superset Environment Variables Template
# Copy this to .env and fill with your values

# Environment mode
SUPERSET_ENV=development

# Database Configuration
SUPERSET_DATABASE_URI=postgresql://user:password@localhost:5432/superset

# IMPORTANT: Generate a secure secret key for production!
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
SUPERSET_SECRET_KEY=your-secret-key-here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Cache Settings
CACHE_TIMEOUT=300

# Security Settings
CSRF_ENABLED=true
ENABLE_PROXY_FIX=false

# CORS Settings (comma-separated origins)
ENABLE_CORS=false
CORS_ORIGINS=http://localhost:3000,http://localhost:9000

# Feature Flags
FF_TEMPLATE_PROCESSING=false
FF_EXPLORE_DRAG_DROP=false
FF_NATIVE_FILTERS=false
FF_CROSS_FILTERS=false

# Logging
LOG_LEVEL=INFO
